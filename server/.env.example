# Neon / PostgreSQL connection strings.
# DIRECT_URL is the non-pooled URL Prisma uses for migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signing key for session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Gemini API key for website generation (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Where this API is reachable, and where the frontend is served from.
# Port 4000, not 3000 — another project on this machine already holds 3000.
SERVER_URL="http://localhost:4000"
CLIENT_URL="http://localhost:5173"

PORT=4000
